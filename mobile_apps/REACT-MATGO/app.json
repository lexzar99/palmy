{
  "expo": {
    "name": "FoodGo",
    "slug": "foodgo",
    "scheme": "foodgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodgoJalle.app",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "NSUserTrackingUsageDescription": "Vi använder detta för att förbättra appens prestanda och förebygga buggar.",
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      },
      "appleTeamId": "3KDGPYZXHH"
    },
    "android": {
      "package": "com.foodgo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8EF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "foodgo",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "foodgo",
              "host": "reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0b0a0f",
          "sounds": []
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.foodgoJalle.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Vi använder detta för att förbättra appens prestanda och förebygga buggar."
        }
      ],
      "@sentry/react-native"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "863d83ac-6dde-47e8-afcf-2526beaf9c8b"
      }
    },
    "owner": "jalleboy0"
  }
}
