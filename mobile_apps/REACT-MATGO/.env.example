EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_SOCKET_URL=https://api.example.com
EXPO_PUBLIC_WEB_URL=https://web.example.com
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
# Optional override — defaults to merchant.com.foodgoJalle.app (must match app.json + Apple Developer)
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.foodgoJalle.app
# Apple Pay is OPT-IN. Leave "false" until you've added Apple Pay capability
# in Xcode (Signing & Capabilities → + Capability → Apple Pay → tick the
# merchant ID) and regenerated the provisioning profile. Setting "true"
# without those steps will throw "merchantIdentifier is required".
EXPO_PUBLIC_APPLE_PAY_ENABLED=false
EXPO_PUBLIC_GEOAPIFY_KEY=replace_me
EXPO_PUBLIC_SUPABASE_URL=https://project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace_me
