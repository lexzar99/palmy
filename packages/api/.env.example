# MatGo API — environment variables

# Auth
JWT_SECRET=                # MÅSTE vara >=32 tecken random i prod (server kraschar annars)

# OAuth (verifierar id_token server-side)
GOOGLE_OAUTH_CLIENT_ID=    # En eller flera (comma-separerade) Google Client-IDs: web/ios/android
APPLE_OAUTH_CLIENT_ID=     # Apple Service ID / Bundle ID som audience

# URL:er
WEB_LOGIN_URL=https://matgo.se/login
WEB_RESET_PASSWORD_URL=https://matgo.se/reset-password
WEB_VERIFY_EMAIL_URL=https://matgo.se/verify-email
MOBILE_RESET_PASSWORD_URL=foodgo://reset-password
MOBILE_VERIFY_EMAIL_URL=foodgo://verify-email

# Email (Supabase sköter verifiering/återställning; Gmail SMTP för interna larm)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# Betalningar (Mollie — provider-neutralt lager)
PAYMENT_PROVIDER=mollie     # mollie | (adyen/stripe när de byggs)
MOLLIE_API_KEY=             # test_… i sandbox, live_… i prod
API_PUBLIC_URL=             # publik https-bas för Mollie-webhook (utelämna i lokal dev)

# Övrigt (lägg till resten enligt behov)
DATABASE_URL=
NODE_ENV=development
