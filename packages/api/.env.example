# ViaEats API — environment variables

# Runtime + databas
NODE_ENV=development
DATABASE_URL=
DIRECT_URL=

# Auth
JWT_SECRET=                # MÅSTE vara >=32 tecken random i prod (server kraschar annars)

# Rate-limit-härdning (valfria; osatta = säker default utan höjda budgetar)
CLOUDFLARE_ORIGIN_SECRET=  # delad hemlighet CF injicerar som header x-viaeats-edge; först då litas cf-connecting-ip på (annars spoofbar vid direkt-mot-origin)
AGENT_LOGIN_KEY=           # delad hemlighet dina AI-agenter skickar som header x-viaeats-agent för höjd login-budget (80 vs 8); osatt = ingen agent höjs
SUPER_ADMIN_EMAIL=         # bootstrap-id; använd inte "admin" i produktion
SUPER_ADMIN_PASSWORD=      # krävs endast om bootstrapkontot saknas; minst 16 tecken
SUPER_ADMIN_NAME=          # valfritt namn för ett explicit lokalt seed-konto

# Farliga lokala seed-skript vägrar alltid produktion. Vid en avsiktlig reset
# av en icke-produktionsdatabas: sätt exakt I_UNDERSTAND_THIS_DELETES_DATA.
VIAEATS_ALLOW_DESTRUCTIVE_SEED=

# OAuth (verifierar id_token server-side)
GOOGLE_OAUTH_CLIENT_ID=    # En eller flera (comma-separerade) Google Client-IDs: web/ios/android
APPLE_OAUTH_CLIENT_ID=     # Apple Service ID / Bundle ID som audience

# URL:er
API_PUBLIC_URL=https://api.viaeats.se
FRONTEND_URL=https://viaeats.se
WEB_LOGIN_URL=https://viaeats.se/login

# Prelaunch. 1 = låst smoke-test, 0 = offentlig launch. Måste vara explicit i prod.
PRELAUNCH_MODE=1
LAUNCH_ACCESS_COOKIE_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email är endast för interna drift-/kapacitetslarm. Kundauth är lösenordsfri
# och launchkuponger följs upp manuellt från admin.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# Betalningar. Mollie är ensam launchprovider; övriga block behålls för legacy.
PAYMENT_PROVIDER=mollie     # production launch: endast mollie (stripe/adyen är legacy)
# Metoder som kassan får erbjuda, kommaseparerat. Kunden väljer i betalmenyn.
# PAYMENT_PROVIDER ovan är fortfarande default/fallback — den här listan styr
# bara vad kassan visar.
PAYMENT_PROVIDERS=mollie,swish
PAYOUT_REFUND_WINDOW_HOURS=72

# Egen Swish Handel via mTLS — INTE Swish genom Mollie. Certifikatet är utfärdat
# direkt av Lunar för vårt eget 123-nummer, så ingen teknisk leverantör behövs.
# Certifikat + nyckel ligger utanför repot (~/.viaeats/swish lokalt); i drift
# sätts SWISH_CLIENT_CERT_CHAIN_PEM/SWISH_KEY_PEM som base64 i hemlighetslagret.
# CLIENT_CERT_CHAIN måste innehålla leaf först och därefter hela issuer-kedjan.
SWISH_ENVIRONMENT=MSS       # MSS | SANDBOX | PRODUCTION
SWISH_PAYEE_ALIAS=1234679304 # MSS-testnummer; produktion = vårt eget 123-nummer
SWISH_CLIENT_CERT_CHAIN_PATH= # canonical full-chain PEM; alternativt *_PEM (PEM eller base64)
SWISH_KEY_PATH=             # alternativt SWISH_KEY_PEM (PEM eller base64)
SWISH_SERVER_CA_PATH=       # valfri server-trust override; alternativt *_PEM
SWISH_CERT_PATH=            # deprecated: full-chain accepteras tillfälligt
SWISH_CA_PATH=              # deprecated: MSS/Sandbox server-root; prod leaf-issuer fallback valideras kryptografiskt
SWISH_KEY_PASSPHRASE=       # MSS-testnyckeln: swish (prod-nyckeln är utan)
SWISH_CALLBACK_SECRET=      # minst 32 slumpade tecken, stabilt mellan deployer
SWISH_CALLBACK_URL=         # valfri lokal override; prod byggs från API_PUBLIC_URL
SWISH_REFUND_CALLBACK_URL=  # valfri override; annars API_PUBLIC_URL + /api/payments/webhooks/swish-refund
SWISH_PAYOUT_FEE_POLICY=    # external | fixed_per_payment; måste väljas uttryckligen före restaurangpayout
SWISH_PAYOUT_FEE_ORE=       # heltal i öre från bankavtalet; krävs bara för fixed_per_payment

# Stripe Checkout (hosted checkout: card/Apple Pay, Klarna, Swish)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=      # whsec_... från Dashboard/Stripe CLI
STRIPE_PAYMENT_METHOD_TYPES=card,klarna,swish
STRIPE_STRICT_PAYMENT_METHODS=false # true = faila checkout om t.ex. Swish ej är aktiverat
STRIPE_PUBLISHABLE_KEY=     # pk_... publik, skickas till native appen (PaymentSheet)

# Adyen (sessions-flöde). Server-secrets i Railway, ej committad .env.
ADYEN_API_KEY=             # server-API-key (Customer Area → API credentials)
ADYEN_MERCHANT_ACCOUNT=    # t.ex. PalmyraPizzeriaAB776
ADYEN_CLIENT_KEY=          # test_… (publik, går i frontend via NEXT_PUBLIC_/EXPO_PUBLIC_)
ADYEN_HMAC_KEY=            # hex, från webhook-konfigen (HmacValidator)
ADYEN_ENVIRONMENT=TEST     # TEST | LIVE
# ADYEN_LIVE_URL_PREFIX=   # endast LIVE: {id}-{company}-prefixet

# Mollie (aktiv launchprovider)
MOLLIE_API_KEY=            # test_… / live_…
# Read-only organization token for exact balance, payout schedule and per-payment
# fees in admin finance. Exact required scopes: balances.read,
# balance-reports.read, payments.read, settlements.read, payouts.read.
# Never expose it to web/admin.
MOLLIE_REPORTING_ACCESS_TOKEN=
MOLLIE_PROFILE_ID=         # pfl_…; krävs när organisationstoken listar betalningar
# Betalningar pollas tätt; aktiva refunds och Dashboard-audit medvetet glesare
# för att inte göra ett Mollie-anrop per order var 15:e sekund.
PAYMENT_RECONCILE_INTERVAL_MS=15000
REFUND_RECONCILE_INTERVAL_MS=300000
REFUND_AUDIT_INTERVAL_MS=3600000

# Launchkritiska integrationer
GOOGLE_MAPS_API_KEY=
FCM_SERVICE_ACCOUNT_JSON= # full service_account-JSON med project_id, client_email och giltig RSA private_key
FCM_PROJECT_ID=           # valfritt extra skydd: måste då matcha JSON:ens project_id
PUSH_TOKEN_ENCRYPTION_KEY= # separat stabil slumphemlighet, minst 32 tecken; byt inte utan planerad tokenrotation
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_P8=
APNS_PRODUCTION=0          # måste vara 1 i produktion
REDIS_URL=                 # krävs för fler än en API-replika
LIVE_STATE=pg              # exakt "redis" aktiverar Redis för live-positioner/ETA
LIVE_STATE_KEY_PREFIX=viaeats:live:v1
LIVE_STATE_AUTH_CACHE=0
MENU_CACHE_TTL_MS=30000
MENU_CACHE_MAX_ENTRIES=200
MENU_CACHE_MAX_BYTES=33554432
MENU_PREWARM_LIMIT=100
MENU_PREWARM_CONCURRENCY=4
SENTRY_DSN=
REVALIDATE_SECRET=
# Meta Instant Form → Office/Admin lead sync. Configure these in Railway,
# then subscribe the ViaEats Page to the leadgen webhook in Meta.
META_LEAD_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Objektlagring
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=         # custom domain, t.ex. https://images.viaeats.se (inte r2.dev i produktion)
