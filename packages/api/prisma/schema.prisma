generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  position     Int         @default(0)
  isActive     Boolean     @default(true)
  imageUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  products     Product[]
}

model Product {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  description         String?
  price               Int
  categoryId          String
  imageUrl            String?
  isActive            Boolean             @default(true)
  isVegan             Boolean             @default(false)
  isVegetarian        Boolean             @default(false)
  isGlutenFree        Boolean             @default(false)
  position            Int                 @default(0)
  // Discount / sale fields for "Rea & rabatterat" section on home.
  // discountPercent overrides discountPrice if both are set.
  discountPercent     Int?                // 1-95 (%)
  discountPrice       Int?                // in öre - direct sale price
  discountImageUrl    String?             // Optional alt image shown in discount rail
  discountLabel       String?             // e.g. "Dagens deal", "-20%"
  discountActive      Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  orderItems          OrderItem[]
  category            Category            @relation(fields: [categoryId], references: [id])
  extraGroups         ProductExtraGroup[]
}

model ExtraGroup {
  id            String              @id @default(cuid())
  name          String
  description   String?
  type          String              @default("CHECKBOX")
  required      Boolean             @default(false)
  minSelections Int                 @default(0)
  maxSelections Int                 @default(99)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  position      Int                 @default(0)
  restaurantId  String?
  extras        Extra[]
  restaurant    Restaurant?         @relation(fields: [restaurantId], references: [id])
  productGroups ProductExtraGroup[]
}

model ProductExtraGroup {
  id           String     @id @default(cuid())
  productId    String
  extraGroupId String
  position     Int        @default(0)
  extraGroup   ExtraGroup @relation(fields: [extraGroupId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, extraGroupId])
}

model Extra {
  id           String     @id @default(cuid())
  name         String
  priceAddon   Int        @default(0)
  extraGroupId String
  isDefault    Boolean    @default(false)
  isActive     Boolean    @default(true)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  extraGroup   ExtraGroup @relation(fields: [extraGroupId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  status                String      @default("PENDING")
  type                  String
  customerName          String
  customerPhone         String
  customerEmail         String?
  deliveryStreet        String?
  deliveryCity          String?
  deliveryZip           String?
  deliveryNote          String?
  deliveryInstructions  String?     // Preset: RING_DOORBELL, LEAVE_AT_DOOR, MEET_OUTSIDE, ENTER_CODE
  total                 Int
  deliveryFee           Int         @default(0)
  discountAmount        Int         @default(0)
  discountCode          String?
  appliedDealId         String?
  appliedDealTitle      String?
  // UserDeal applied at checkout (welcome/referral-coupon från användarens
  // /api/account/deals). Frusen vid order-creation och reserverad atomiskt
  // tills payment success → markeras USED. Vid payment fail/cancel → revertas
  // till ACTIVE så användaren kan använda den igen.
  userDealId            String?
  userDealAmountKr      Int?
  stripePaymentIntentId String?
  paymentStatus         String      @default("PENDING")
  paymentMethod         String      @default("ONLINE")
  note                  String?
  estimatedTime         Int?
  refundAmount          Int?        // Partial or full refund in öre
  refundReason          String?     // Reason for refund
  refundedAt            DateTime?   // When the refund was issued
  rating                Int?        // 1-5 star rating from customer
  review                String?     // Customer review text
  reviewedAt            DateTime?   // When the review was submitted
  reviewFlagged         Boolean     @default(false)
  reviewReply           String?
  // JSON-array av OrderItem.productId som kunden "likade" i sin review.
  // Visas under reviewen på restaurangens reviews-sida som tags. Tomt
  // array = inga rätter explicit likade.
  likedItemIds          String      @default("[]")
  reviewRepliedAt       DateTime?
  allergens             String      @default("[]") // Customer allergens captured at order time
  // Guard mot dubbel-increment av discount/deal usageCount. Både Stripe-
  // webhook och reconcile-poller kan trigga increment-logiken — utan denna
  // flag riskerade samma order räknas 2x. Atomisk uppdatering med
  // `where: { id, discountUsageCounted: false }` säkrar att bara en path vinner.
  discountUsageCounted  Boolean     @default(false)
  preparingAt           DateTime?   // When admin moved order into PREPARING — anchor for the countdown shown in the LiveActivity widget
  deliveringAt          DateTime?   // When order was marked as DELIVERING (for delayed display to customer + LA on-the-way countdown)
  scheduledFor          DateTime?   // Customer-requested delivery/pickup time (null = ASAP)
  liveActivityToken     String?     // iOS Live Activity push token (per-activity, lets backend push state updates to Dynamic Island)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  restaurantId          String?
  restaurant            Restaurant? @relation(fields: [restaurantId], references: [id])
  items                 OrderItem[]
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])

  @@index([restaurantId, status, createdAt])
  @@index([customerPhone])
  @@index([stripePaymentIntentId])
  @@index([userId])
  @@index([appliedDealId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  basePrice      Int
  quantity       Int      @default(1)
  note           String?
  selectedExtras String   @default("[]")
  subtotal       Int
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
}

model DiscountCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  description           String?
  type                  String    @default("PERCENTAGE")
  value                 Int
  minOrder              Int       @default(0)
  isActive              Boolean   @default(true)
  maxUsages             Int?
  usageCount            Int       @default(0)
  validFrom             DateTime?
  validUntil            DateTime?
  applicableCategoryIds   String    @default("[]")
  restaurantId            String?
  applicableRestaurantIds String    @default("[]")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Deal {
  id                    String      @id @default(cuid())
  title                 String
  description           String?
  imageUrl              String?
  badgeText             String?
  // Popup-specifika fält. Används av claim-popupen i web/RN. När popupBuilder
  // skapar en deal sätter admin dessa: vad popupen säger, vilken kod kunden
  // ser efter claim, och CTA-knappens text. Lämnas tomma blir popup en
  // standard-rendering av title + description.
  popupHeadline         String?
  popupBody             String?
  popupCtaLabel         String?
  popupCode             String?
  // Popup-typ: false (default) = "Spara erbjudande" + "Inte nu" knappar.
  // true = bara "OK"-knapp (för informativa popups utan kod att claima).
  popupOkOnly           Boolean     @default(false)
  triggerType           String      @default("NONE")
  discountType          String      @default("PERCENTAGE")
  discountValue         Int
  minOrder              Int         @default(0)
  comboProductIds       String      @default("[]")
  isActive              Boolean     @default(true)
  showOnSite            Boolean     @default(true)
  popupEnabled          Boolean     @default(true)
  maxUsages             Int?
  maxUsesPerCustomer    Int?
  usageCount            Int         @default(0)
  validFrom             DateTime?
  validUntil            DateTime?
  sortOrder             Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  restaurantId          String?
  isGlobal              Boolean     @default(false)
  applicableRestaurantIds   String    @default("[]")
  triggerCategoryId         String?
  triggerQuantity           Int       @default(2)
  rewardCategoryId          String?
  bogoExcludedProductIds    String    @default("[]")
  bogoRewardProductIds      String    @default("[]")
  bogoExcludedExtraIds      String    @default("[]")    // JSON-array av Extra.id som hindras när BOGO-gratisvara väljs (t.ex. "vitlökssås", "panpizza-storlek")
  bogoMaxRewardPriceOre     Int?
  bogoMinOrderAmountOre     Int?
  bogoTriggerProductIds     String    @default("[]")
  showAsBanner              Boolean   @default(false)
  // Personal-template: Dealen syns INTE som global rabatt på sajten
  // (inte i /api/deals, inga popups, inga banners). Den används endast
  // som mall av referral-systemet som snapshotar dess värden in i
  // UserDeal-rader per användare. true = exklusivt för referral/welcome.
  isPersonalTemplate    Boolean   @default(false)
  restaurant            Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([isActive, restaurantId, validUntil])
  @@index([isActive, isGlobal])
  @@index([restaurantId, triggerType])
}

model HomeCategorySection {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  subtitle          String?
  description       String?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  filterMode        String   @default("FILTER") // FILTER, MANUAL, HYBRID
  maxRestaurants    Int      @default(8)
  manualRestaurantIds String @default("[]")
  filters           String   @default("{}")
  schedule          String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  // Klartext-spegling av lösenordet — används BARA av admin-panelens
  // restaurang-login-tab så superadmin kan se vad som faktiskt är satt
  // (Flutter-appens credentials). Bcrypt är envägs så vi kan inte
  // återhämta det från `password`. Befintliga konton har null tills
  // någon sätter ett nytt lösenord.
  passwordPlain String?
  name          String
  role          String   @default("STAFF")
  isActive      Boolean  @default(true)
  // TOTP (2FA) — otplib-genererat base32-secret. När totpEnabled=true
  // krävs en kod vid login från ny enhet. Lagras encrypted-at-rest av Postgres.
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  // Tidstämpel när recovery codes senast genererades (för att visa varning
  // till admin om de är gamla)
  recoveryGeneratedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trustedDevices TrustedDevice[]
  recoveryCodes  RecoveryCode[]
}

// Trusted device — när admin loggat in med TOTP får enheten en cookie som
// gäller 30 dagar. Då slipper man TOTP-prompt nästa gång på samma dator.
// Admin kan revoka enheter från /2fa-sidan om de tappat dem.
model TrustedDevice {
  id           String    @id @default(cuid())
  adminId      String
  // bcrypt-hash av cookie-tokenen (samma princip som lösenord — vi vill
  // inte lagra tokens i klartext)
  tokenHash    String
  // User-friendly label så admin kan känna igen enheten i listan
  // ('Chrome på MacBook Pro · Stockholm')
  deviceLabel  String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

// Recovery codes — 10 engångskoder genererade vid TOTP-setup. Om admin
// tappar telefonen kan de använda en kod istället för TOTP. Engångsbruk.
model RecoveryCode {
  id        String    @id @default(cuid())
  adminId   String
  codeHash  String    // bcrypt-hash av en kod som "ABCD-1234"
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// Audit-log — varje mutation från admin loggas hit. Används för support
// (vem ändrade vad), forensics (vid intrång) och compliance.
model AuditLog {
  id           String   @id @default(cuid())
  adminId      String?  // Null om endpoint är publik eller webhook
  adminEmail   String?  // Snapshot — kvarstår om admin-kontot raderas
  action       String   // ORDER_REFUND, RESTAURANT_DEACTIVATE, etc.
  resourceType String   // Order, Restaurant, Customer, etc.
  resourceId   String?
  changes      String?  // JSON-string av {before, after}
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model RestaurantSettings {
  id                    String   @id @default("settings")
  isOpen                Boolean  @default(true)
  deliveryFee           Int      @default(0)
  minOrderAmount        Int      @default(0)
  deliveryRadius        Int      @default(10)
  estimatedPickupTime   Int      @default(20)
  estimatedDeliveryTime Int      @default(35)
  notificationSound     String   @default("signal-1")
  openingHours          String   @default("{}")
  updatedAt             DateTime @updatedAt
  phone                 String?

  // Platform/företags-info — används av kontakt- och om-oss-sidorna på web.
  // Inget med restauranger att göra (trots tabellnamnet). Egen tabell senare,
  // men för enkelhetens skull återanvänder vi singleton-raden här.
  contactPhone          String?
  contactPhoneHours     String?  // ex: "Mån-Fre 09:00 – 17:00"
  contactEmail          String?
  contactAddress        String?  // multiline OK
  aboutBody             String?  // markdown / plain text för om-oss-sidan

  // Företagsidentitet — visas i Terms + Privacy + RN-support-flöden. Singleton
  // för hela plattformen. Fallback-värden hanteras i klienterna när null.
  companyName           String?  // ex: "MatGo AB"
  organizationNumber    String?  // ex: "559123-4567"
  companyAddress        String?  // postal/registrerad adress, multiline OK
  supportEmail          String?  // primär support — RN + web SupportChat
  privacyEmail          String?  // GDPR/DPO-kontakt
  noReplyEmail          String?  // From-adress i sendEmail (valbar)

  // Platform-wide UI-toggles
  showDiscountedRail    Boolean  @default(true)  // Rea & Rabatter-sektion på hem-sidan

  // Plattform-banner: visas högst upp i web när satt. Används för
  // "Underhåll pågår 13-14", "Vi har problem med betalningar just nu", etc.
  bannerMessage         String?
  bannerSeverity        String?  // "info" | "warning" | "critical"
  bannerExpiresAt       DateTime? // Auto-rensar — null = visas tills manuellt borttagen

  // Welcome deal — auto-tilldelas vid registrering om aktiv. Pekar på
  // en Personal Template-Deal (samma pattern som referral). Admin skapar
  // mallen i /marketing-referrals och pekar hit via welcomeDealId.
  // Legacy-fälten (amountKr/Percent/MinOrderKr/ExpiresDays) behålls för
  // bakåtkompat men används INTE av ny logik.
  welcomeDealActive       Boolean   @default(false)
  welcomeDealId           String?
  welcomeDealAmountKr     Int       @default(50)   // legacy
  welcomeDealPercent      Int       @default(20)   // legacy
  welcomeDealMinOrderKr   Int       @default(150)  // legacy
  welcomeDealExpiresDays  Int       @default(30)   // legacy

  // Referral-system — använder en valfri Deal som mall för rabatten.
  // Admin skapar Dealen i /admin/deals och pekar hit via referralDealId.
  // När referral triggas skapas UserDeal(s) som pekar på Dealen och
  // snapshotar dess discountValue → UserDeals frusna även om Dealen
  // senare ändras. referralCouponsPerSide styr hur många kuponger
  // varje part får (1 = klassisk, 3 = "första 3 ordrar"-modell).
  //
  // referralRewardKr/Percent/MinOrderKr behålls för bakåtkompat men
  // används INTE av ny logik — Dealen själv bär dessa värden nu.
  referralEnabled              Boolean   @default(false)
  referralDealId               String?
  referralCouponsPerSide       Int       @default(1)
  referralRewardKr             Int       @default(50)   // legacy
  referralRewardPercent        Int       @default(20)   // legacy
  referralMinOrderKr           Int       @default(150)  // legacy
  referralMaxRewardsPerInviter Int       @default(20)
}

model OrderDraft {
  id        String   @id @default(cuid())
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Restaurant {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  description    String?
  cuisine        String       @default("Blandat")
  address        String?
  city           String?      @default("Lund")
  zip            String?
  phone          String?
  imageUrl       String?
  heroImageUrl   String?
  rating         Float?       @default(4.6)
  ratingCount    Int?         @default(120)
  deliveryFee    Int          @default(0)
  minOrderAmount Int          @default(0)
  etaMinutes     Int          @default(30)
  etaCalculatedMinutes Int?               // Auto-beräknad ETA baserad på senaste 20 ordrarnas createdAt → deliveringAt (clampad 25–55 min). null = för få ordrar än
  etaOverrideMinutes   Int?               // Manuell admin-override. Om satt åsidosätter etaCalculatedMinutes
  isOpen         Boolean      @default(true)
  tags           String       @default("[]")
  openingHours   String       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  featuredClass  Int          @default(3)
  internalInfo   String?
  adminEmail     String?
  logoutCode     String?
  pausedUntil    DateTime?
  latitude       Float?
  longitude      Float?
  deliveryRadius Float              @default(5.0)
  cityId         String?
  city_relation  City?              @relation(fields: [cityId], references: [id])
  deliveryZones  String             @default("[]")  // JSON: [{name, radiusKm, fee, minOrder, isActive}]
  freeDeliveryAbove Int?            // Free delivery if order > this amount in öre (kr*100)
  // Direkt FK till AdminUser-kontot som Flutter-restaurang-appen loggar
  // in med. Sätts automatiskt vid första GET /admin/restaurants/:id/login
  // baserat på fuzzy-match, eller manuellt när admin skapar/byter konto.
  // Garanterar 1-till-1 — ingen mer fuzzy-gissning i UI:t.
  adminUserId    String?            @unique
  announcementText String?          // Info-banner på restaurangsidan (t.ex. adressändring, stängt idag)
  vatPercent     Int?               // Moms i % som visas i kassan (6 eller 12). null = visas inte
  categories     Category[]
  deals          Deal[]
  extraGroups    ExtraGroup[]
  orders         Order[]
  groupOrders    GroupOrder[]
  payouts        RestaurantPayout[]
  printers       RestaurantPrinter[]
}

model City {
  id                String       @id @default(cuid())
  name              String       @unique
  slug              String       @unique
  isActive          Boolean      @default(true)
  deliveryMode      String       @default("ALL")
  zones             String       @default("[]")
  polygon           String?      // GeoJSON polygon coords [[lng,lat],...] for delivery boundary
  centerLat         Float?       // Map center lat
  centerLng         Float?       // Map center lng
  radiusKm          Float        @default(10.0) // Fallback radius if no polygon
  latitude          Float?       // Legacy
  longitude         Float?       // Legacy
  freeDeliveryAbove Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  restaurants       Restaurant[]
}

model User {
  id             String         @id @default(cuid())
  email          String?        @unique
  phone          String?        @unique
  password       String?
  name           String
  firstName      String?
  lastName       String?
  address        String?
  city           String?
  zip            String?
  isActive       Boolean        @default(true)
  isVerified     Boolean        @default(false)
  isGuest        Boolean        @default(false)
  oauthProvider  String?
  oauthId        String?
  image          String?
  // Forgot-password flow — vi lagrar en kryptografiskt slumpad token + utgångstid.
  // Tokenen mejlas till användaren via en länk; klienten POSTar tillbaka token +
  // nytt lösenord till /api/account/reset-password. Båda fälten nollställs när
  // återställningen är gjord. Index på tokenen för snabb lookup.
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?
  // Email-verifierings-flöde — POST /api/account/send-verification-email
  // genererar en token, mejlar länk; klienten POSTar tillbaka till
  // /api/account/verify-email vilket sätter emailVerifiedAt och nollar
  // tokenen. RN-klienten pollar /api/account/check-email-verified.
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?
  emailVerifiedAt            DateTime?
  orders         Order[]
  deals          CustomerDeal[]
  savedAddresses SavedAddress[]
  allergens      String         @default("[]")
  pushToken      String?
  apnsDeviceToken String?       // Raw iOS APNs device token (hex) for direct push with apns-collapse-id support
  internalInfo   String?
  deletedAt      DateTime?      // Soft-delete marker. authenticateUser rejects with 401 when set, so a deleted customer can't auto-recreate themselves through token validation.
  // JSON-array av Deal.id som kunden har "claimat" från admin-broadcast
  // popup. Visas i profile/deals tillsammans med globala deals och
  // appliceras i checkout om villkoren matchar.
  claimedDealIds String         @default("[]")
  // Referral-system. `referralCode` är det unika invite-code som
  // genereras lazily när användaren öppnar referral-sidan. `referredByCode`
  // sätts om användaren registrerade sig via en delningslänk.
  // `deviceFingerprint` är ett opaque klient-värde (best-effort) som vi
  // använder för soft-fraud-flags — aldrig som hard-block.
  referralCode        String?  @unique
  referredByCode      String?
  deviceFingerprint   String?
  // Senaste IP-adressen vi sett från användaren. Används BARA som signal
  // för fraud-flags (samma IP som inviter → soft-flag). Skrivs lazily när
  // referral-endpointer triggas; legacy-konton har null tills de aktiverar
  // referral-flödet.
  lastSeenIp          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deals_v2       UserDeal[]
  referralsSent     Referral[]   @relation("ReferralInviter")
  referralReceived  Referral?    @relation("ReferralInvitee")
}

// UserDeal — en personlig rabattkupong som tillhör EN användare. Skapas av:
//  - Welcome-deal-flow (auto vid registrering om welcomeDealActive)
//  - Referral-reward (50 kr till BÅDA inviter + invitee när invitee:s
//    första betalda order kommer in)
//  - Manuell admin-utdelning (typ=MANUAL, ex. som kompensation efter
//    försening)
//
// `amountKr` är primärt för cash-rabatter (kr off). `dealId` är reserverat
// för framtida koppling till befintliga Deal-rader (procent/BOGO/etc.).
// `metadata` är fritt JSON för flow-specifik data (ex. minOrderKr,
// referralId, inviterUserId) som UI:t läser direkt utan extra joins.
model UserDeal {
  id              String    @id @default(cuid())
  userId          String
  dealId          String?   // referens till befintlig Deal-modell, null för auto-cash-rabatt
  type            String    // WELCOME | REFERRAL_INVITER | REFERRAL_INVITEE | MANUAL
  status          String    @default("ACTIVE") // ACTIVE | USED | EXPIRED
  amountKr        Int?      // legacy cash-rabatt (50 = 50 kr). Behålls för bakåtkompat.
  discountPercent Int?      // procent-rabatt på subtotal (20 = 20%). Föredras över amountKr.
  expiresAt       DateTime?
  usedAt          DateTime?
  usedOnOrderId   String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([type])
}

// Referral — en delningsrelation mellan en inviter och en (potentiell)
// invitee. Skapas i två faser:
//   1. PENDING — när inviter:s `referralCode` används mot
//      /api/account/redeem-code (eller vid registrering med ?ref=).
//      Vi vet ofta bara email/ip/deviceFingerprint i detta läge.
//   2. REGISTERED — när invitee-kontot skapas och vi kan länka
//      inviteeUserId.
//   3. ORDERED — när invitee:s första betalda order trillar in:
//      vi skapar UserDeals för båda parter och flippar till ORDERED.
//   4. REVERTED — admin kan i monitorn nolla ut en reward (ex. uppenbar
//      fusk) vilket också nollar tillhörande UserDeals.
//
// `fraudFlags` är en sträng-array av sanity-signaler (SAME_IP,
// SAME_DEVICE, etc.) som vi SAMLAR men ALDRIG blockar på. Admin ser dem
// i listan och avgör manuellt.
model Referral {
  id                String    @id @default(cuid())
  code              String    @unique // typ "ANNA8X3K"
  inviterUserId     String
  inviteeUserId     String?   @unique // en användare kan bara bli refererad EN gång
  inviteeEmail      String?
  inviteeIP         String?
  inviteeDeviceId   String?
  status            String    @default("PENDING") // PENDING | REGISTERED | ORDERED | REVERTED
  fraudFlags        String[]  @default([])
  inviteeOrderId    String?   // ordern som triggade rewarden
  createdAt         DateTime  @default(now())
  registeredAt      DateTime?
  rewardedAt        DateTime?
  revertedAt        DateTime?
  revertedBy        String?   // adminUserId
  revertReason      String?

  inviter           User      @relation("ReferralInviter", fields: [inviterUserId], references: [id])
  invitee           User?     @relation("ReferralInvitee", fields: [inviteeUserId], references: [id])

  @@index([inviterUserId])
  @@index([status])
}

model RestaurantPayout {
  id                 String     @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  periodStart        DateTime
  periodEnd          DateTime
  grossSales         Int        @default(0)
  orderCount         Int        @default(0)
  commissionAmount   Int        @default(0)
  subscriptionAmount Int        @default(0)
  adjustmentAmount   Int        @default(0)
  payoutAmount       Int        @default(0)
  status             String     @default("DRAFT")
  notes              String?
  payoutReference    String?
  approvedAt         DateTime?
  approvedBy         String?
  paidAt             DateTime?
  paidBy             String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([restaurantId, periodStart, periodEnd])
  @@index([status, periodStart, periodEnd])
}

model RestaurantPrinter {
  id             String     @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  connectionType String     @default("NETWORK")
  address        String
  paperWidth     String     @default("80mm")
  copies         Int        @default(1)
  autoPrint      Boolean    @default(false)
  isDefault      Boolean    @default(false)
  isActive       Boolean    @default(true)
  receiptMode    String     @default("STANDARD")
  notes          String?
  lastSeenAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([restaurantId, isDefault])
  @@index([restaurantId, isActive])
}

model ReceiptTemplate {
  id           String   @id @default("global")
  paperWidth   String   @default("80mm")
  platformName String   @default("MatGo")
  elements     String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Hem")  // Hem, Jobb, Annat
  street    String
  city      String
  zip       String
  note      String?  // Door code, floor, etc.
  isDefault Boolean  @default(false)
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Campaign {
  id                    String         @id @default(cuid())
  title                 String
  description           String?
  discountType          String         @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue         Int
  minOrder              Int            @default(0)
  maxUsagesPerCustomer  Int            @default(1)
  isActive              Boolean        @default(true)
  validFrom             DateTime?
  validUntil            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deals                 CustomerDeal[]
}

model CustomerDeal {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String
  code         String    @unique
  usageCount   Int       @default(0)
  maxUsages    Int       @default(1)
  isUsed       Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model GroupOrder {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id])
  ownerId      String?
  ownerName    String
  ownerPhone   String?
  status       String           @default("OPEN") // OPEN, LOCKED, COMPLETED, CANCELLED
  shareCode    String           @unique
  items        GroupOrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([restaurantId])
  @@index([shareCode])
}

model GroupOrderItem {
  id           String     @id @default(cuid())
  groupOrderId String
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  userName     String
  quantity     Int        @default(1)
  basePrice    Int
  selectedExtras String   @default("[]")
  note         String?
  subtotal     Int
  createdAt    DateTime   @default(now())
}

model PushLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  target     String   // "all" | "user" | "city"
  identifier String?  // userId/email/phone for "user" target
  city       String?  // city name for "city" target
  title      String
  body       String
  deeplink   String?
  count      Int      @default(0)
  success    Boolean  @default(true)
  error      String?
  sentBy     String?

  @@index([createdAt])
}
