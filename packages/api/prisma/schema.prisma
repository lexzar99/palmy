generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  position     Int         @default(0)
  isActive     Boolean     @default(true)
  imageUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  products     Product[]
}

model Product {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?
  price        Int
  categoryId   String
  imageUrl     String?
  isActive     Boolean             @default(true)
  isVegan      Boolean             @default(false)
  isVegetarian Boolean             @default(false)
  isGlutenFree Boolean             @default(false)
  position     Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  orderItems   OrderItem[]
  category     Category            @relation(fields: [categoryId], references: [id])
  extraGroups  ProductExtraGroup[]
}

model ExtraGroup {
  id            String              @id @default(cuid())
  name          String
  description   String?
  type          String              @default("CHECKBOX")
  required      Boolean             @default(false)
  minSelections Int                 @default(0)
  maxSelections Int                 @default(99)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  position      Int                 @default(0)
  restaurantId  String?
  extras        Extra[]
  restaurant    Restaurant?         @relation(fields: [restaurantId], references: [id])
  productGroups ProductExtraGroup[]
}

model ProductExtraGroup {
  id           String     @id @default(cuid())
  productId    String
  extraGroupId String
  position     Int        @default(0)
  extraGroup   ExtraGroup @relation(fields: [extraGroupId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, extraGroupId])
}

model Extra {
  id           String     @id @default(cuid())
  name         String
  priceAddon   Int        @default(0)
  extraGroupId String
  isDefault    Boolean    @default(false)
  isActive     Boolean    @default(true)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  extraGroup   ExtraGroup @relation(fields: [extraGroupId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           Int         @unique
  status                String      @default("PENDING")
  type                  String
  customerName          String
  customerPhone         String
  customerEmail         String?
  deliveryStreet        String?
  deliveryCity          String?
  deliveryZip           String?
  deliveryNote          String?
  total                 Int
  deliveryFee           Int         @default(0)
  discountAmount        Int         @default(0)
  discountCode          String?
  appliedDealId         String?
  appliedDealTitle      String?
  stripePaymentIntentId String?
  paymentStatus         String      @default("PENDING")
  paymentMethod         String      @default("ONLINE")
  note                  String?
  estimatedTime         Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  restaurantId          String?
  restaurant            Restaurant? @relation(fields: [restaurantId], references: [id])
  items                 OrderItem[]
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  basePrice      Int
  quantity       Int      @default(1)
  note           String?
  selectedExtras String   @default("[]")
  subtotal       Int
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
}

model DiscountCode {
  id                    String    @id @default(cuid())
  code                  String    @unique
  description           String?
  type                  String    @default("PERCENTAGE")
  value                 Int
  minOrder              Int       @default(0)
  isActive              Boolean   @default(true)
  maxUsages             Int?
  usageCount            Int       @default(0)
  validFrom             DateTime?
  validUntil            DateTime?
  applicableCategoryIds String    @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Deal {
  id                 String      @id @default(cuid())
  title              String
  description        String?
  badgeText          String?
  triggerType        String      @default("NONE")
  discountType       String      @default("PERCENTAGE")
  discountValue      Int
  minOrder           Int         @default(0)
  comboProductIds    String      @default("[]")
  isActive           Boolean     @default(true)
  showOnSite         Boolean     @default(true)
  popupEnabled       Boolean     @default(true)
  maxUsages          Int?
  maxUsesPerCustomer Int?
  usageCount         Int         @default(0)
  validFrom          DateTime?
  validUntil         DateTime?
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  restaurantId       String?
  isGlobal           Boolean     @default(false)
  restaurant         Restaurant? @relation(fields: [restaurantId], references: [id])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("STAFF")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantSettings {
  id                    String   @id @default("settings")
  isOpen                Boolean  @default(true)
  deliveryFee           Int      @default(0)
  minOrderAmount        Int      @default(0)
  deliveryRadius        Int      @default(10)
  estimatedPickupTime   Int      @default(20)
  estimatedDeliveryTime Int      @default(35)
  notificationSound     String   @default("signal-1")
  openingHours          String   @default("{}")
  updatedAt             DateTime @updatedAt
  phone                 String?
}

model OrderDraft {
  id        String   @id @default(cuid())
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Restaurant {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  description    String?
  cuisine        String       @default("Blandat")
  address        String?
  city           String?      @default("Lund")
  zip            String?
  phone          String?
  imageUrl       String?
  heroImageUrl   String?
  rating         Float?       @default(4.6)
  ratingCount    Int?         @default(120)
  deliveryFee    Int          @default(0)
  minOrderAmount Int          @default(0)
  etaMinutes     Int          @default(30)
  isOpen         Boolean      @default(true)
  tags           String       @default("[]")
  openingHours   String       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  featuredClass  Int          @default(3)
  internalInfo   String?
  categories     Category[]
  deals          Deal[]
  extraGroups    ExtraGroup[]
  orders         Order[]
}

model City {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  isActive     Boolean  @default(true)
  deliveryMode String   @default("ALL")
  zones        String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  password     String?
  name         String
  address      String?
  city         String?
  zip          String?
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  oauthProvider String?
  oauthId      String?
  image        String?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
