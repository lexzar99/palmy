{
  "name": "@viaeats/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/index.ts",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "prisma generate --schema prisma/schema.prisma && tsc",
    "test:contracts": "ts-node --transpile-only src/contracts/backendContracts.test.ts && ts-node --transpile-only src/contracts/launchCampaignPagination.test.ts",
    "test:home-categories": "ts-node --transpile-only src/contracts/homeCategoryFeed.test.ts",
    "test:live-state": "ts-node src/contracts/liveState.test.ts && ts-node src/contracts/courierLivePosition.test.ts",
    "test:order-status": "ts-node --transpile-only src/contracts/orderStatusMachine.test.ts",
    "test:dispatch": "ts-node --transpile-only src/contracts/courierDispatch.test.ts",
    "test:referrals": "ts-node --transpile-only src/contracts/referralContracts.test.ts",
    "test:refunds": "ts-node --transpile-only src/contracts/refundContracts.test.ts",
    "test:finance-payouts": "ts-node --transpile-only src/contracts/financePayoutContracts.test.ts",
    "test:hermes": "ts-node --transpile-only src/contracts/hermesAlerts.test.ts",
    "test:customer-notifier": "ts-node --transpile-only src/contracts/customerOrderNotifier.test.ts",
    "test:notification-access": "ts-node --transpile-only src/contracts/customerNotificationAccess.test.ts",
    "test:order-access": "ts-node --transpile-only src/contracts/orderAccess.test.ts",
    "test:order-extra-pricing": "ts-node --transpile-only src/contracts/orderExtraPricing.test.ts",
    "test:checkout-integrity": "ts-node --transpile-only src/contracts/checkoutPricingIntegrity.test.ts",
    "test:mollie-lines": "ts-node --transpile-only src/contracts/mollieLines.test.ts",
    "test:readiness": "ts-node --transpile-only src/contracts/launchReadiness.test.ts",
    "test:admin-auth-p0": "ts-node --transpile-only src/contracts/adminAuthP0.test.ts",
    "test:database-readiness": "ts-node --transpile-only src/contracts/launchDatabaseReadiness.test.ts",
    "db:readiness": "ts-node --transpile-only scripts/check-launch-database.ts",
    "test:prelaunch-access": "ts-node --transpile-only src/contracts/prelaunchAccess.test.ts",
    "test:request-security": "ts-node --transpile-only src/contracts/requestSecurity.test.ts",
    "test:notification-outbox": "ts-node --transpile-only src/contracts/notificationOutbox.test.ts",
    "test:notification-reconciler": "ts-node --transpile-only src/contracts/customerNotificationReconciler.test.ts",
    "test:schema-baseline": "bash scripts/test-schema-baseline.sh",
    "test:migration-isolation": "bash scripts/test-menu-isolation-migration.sh",
    "test:migration-payment-tax": "bash scripts/test-payment-tax-migration.sh",
    "test:migration-notifications": "bash scripts/test-customer-notification-migration.sh",
    "test:migration-payout-recovery": "bash scripts/test-payout-recovery-migration.sh",
    "test:migration-refund-ledger": "bash scripts/test-refund-ledger-migration.sh",
    "test:migration-customer-auth": "bash scripts/test-customer-auth-migrations.sh",
    "start": "node dist/index.js",
    "migrate:r2": "ts-node scripts/migrate-cloudinary-to-r2.ts"
  },
  "dependencies": {
    "@adyen/api-library": "^30.1.0",
    "@aws-sdk/client-s3": "^3.1050.0",
    "@mollie/api-client": "^4.3.0",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^10.53.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/multer": "^2.1.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "js-yaml": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.0.1",
    "multer": "^2.1.1",
    "next-auth": "^4.24.13",
    "nodemailer": "^6.10.1",
    "otplib": "^13.4.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.0",
    "stripe": "^17.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.23",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
