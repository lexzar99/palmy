# Kurir-appen (Vite + PWA) — miljövariabler.
# Sätt dessa i Vercel: Project → Settings → Environment Variables (Production + Preview).

# Backend-API (Railway). api.ts defaultar redan till denna, men sätt explicit
# så det är tydligt och lätt att byta till ev. egen API-domän senare.
VITE_API_URL=https://palmy-production-2021.up.railway.app

# Mock-läge. LÄMNA OSATT i produktion (= skarpt mot backend).
# Sätt "1" bara för en lokal demo helt utan backend.
# VITE_USE_MOCK=1
