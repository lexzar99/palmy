# Public API endpoints
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
API_URL=http://localhost:4000
# Publik Cloudflare R2 custom domain, t.ex. https://images.viaeats.se.
# Behåll den gamla r2.dev-hostens allowlist under URL-migreringen.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Auth (server-only except the explicitly public Supabase values)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Launch gate — same 1/0 semantics as the API.
# Production fails closed if PRELAUNCH_MODE is missing or invalid.
# Use 1 for the private smoke test and 0 for public launch.
PRELAUNCH_MODE=1
LAUNCH_ACCESS_CODE_SHA256=
LAUNCH_ACCESS_COOKIE_SECRET=

# Meta Pixel för webb-leads. Publikt ID, används endast för Meta-klientkoden.
NEXT_PUBLIC_META_PIXEL_ID=1850021916382355
